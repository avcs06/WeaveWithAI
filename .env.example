# Anthropic API key, for the spec stages and, unless CLAUDE_AUTH says otherwise, the coding sessions.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# A stronger model for the first drafts that set the app's direction: scope, theme and architect.
LLM_MODEL_STRONG=claude-opus-5-5
# Reuse recorded responses when the request is identical.
LLM_REPLAY=true

# Claude Code, which the coding stages run headless on LLM_MODEL.
CLAUDE_BIN=claude
# true runs each session in the weave-agent container with only the app mounted;
# false runs it on the host, with no permission prompts.
CLAUDE_DOCKER=true
# subscription runs the sessions on your Claude subscription instead of
# ANTHROPIC_API_KEY, with the token `claude setup-token` prints.
CLAUDE_AUTH=api
CLAUDE_CODE_OAUTH_TOKEN=
