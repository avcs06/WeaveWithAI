# Meta Model API (OpenAI-compatible): https://dev.meta.ai/docs
MODEL_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
# A stronger model for repairs that failed twice (Decision D1.8).
LLM_MODEL_STRONG=muse-wonder-1.0
# Model used to review screenshots; confirm it accepts images before relying on it.
LLM_MODEL_VISION=muse-spark-1.3
# Reuse recorded responses when the request is identical (Decision D1.9).
LLM_REPLAY=true
