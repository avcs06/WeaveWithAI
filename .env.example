# Meta Model API (OpenAI-compatible): https://dev.meta.ai/docs
MODEL_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
# A stronger model for repairs that failed twice.
LLM_MODEL_STRONG=muse-wonder-1.0
# Model used to review screenshots; confirm it accepts images before relying on it.
LLM_MODEL_VISION=muse-spark-1.3
# Reuse recorded responses when the request is identical.
LLM_REPLAY=true

# Where calls go: meta (default), modal or baseten. The
# backend name is in every event and in the replay key. See modal/README.md.
LLM_BACKEND=meta
# Modal Dedicated Endpoint (GPU time, paid from the Modal credits) serving Muse
# Glimmer 30B. `modal endpoint info <name>` prints the URL (add /v1) and the model
# name. Endpoints take a proxy token (`modal workspace proxy-tokens create`,
# wk-<id>.ws-<secret>), not the CLI's API token from `modal setup`.
MODAL_BASE_URL=
MODAL_PROXY_TOKEN=
MODAL_MODEL=
# Baseten Model API for Muse Spark Open, per token. GET <BASETEN_BASE_URL>/models
# with the key lists the ids it may call; the hackathon key is scoped to one.
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Muse Code, which the coding stages run headless. The model is
# pinned per backend; contributor mode is always off.
MUSE_BIN=muse
# true runs each session in the weave-agent container with only the app mounted.
MUSE_DOCKER=true
# subscription runs Meta sessions on your Muse Code login (`muse login`) instead
# of MODEL_API_KEY. Modal and Baseten always use their keys.
MUSE_AUTH=api
# OpenCode, which the coding stages run on Baseten instead of Muse Code.
# MUSE_DOCKER runs it in the same container.
OPENCODE_BIN=opencode
