{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "module": "node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "types": ["jest", "node"]
  },
  "exclude": ["node_modules", ".next"],
  "include": [
    "specs/**/*.ts",
    "specs/**/*.tsx",
    "app/**/*.test.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ]
}
