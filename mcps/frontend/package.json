{
  "name": "weave-frontend-mcp",
  "version": "1.0.3",
  "private": true,
  "description": "MCP server that makes this repository's design system queryable by coding agents, and agent-generated UI checkable against it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx watch src/mcp/stdio.ts",
    "start": "node dist/mcp/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\""
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "react-docgen-typescript": "^2.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "vitest": "^3.2.4"
  }
}
