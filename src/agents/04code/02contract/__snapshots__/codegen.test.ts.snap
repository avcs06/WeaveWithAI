  useSessionStore.setState(({ records }) => ({ records: records.map((r) => (r.id === id ? record : r)) }));
  return record;
}

export async function deleteSession(id: string): Promise<void> {
  await mockCall('deleteSession');
  useSessionStore.setState(({ records }) => ({ records: records.filter((record) => record.id !== id) }));
