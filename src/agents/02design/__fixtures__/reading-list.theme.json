{
  "brief": {
    "audience": "People who read a lot and lose track of what they meant to read next.",
    "personality": [
      "calm",
      "literary",
      "quiet",
      "warm"
    ],
    "voice": "plain, warm, second person",
    "density": "comfortable",
    "signature": "Bookish Playfair Display headings over a warm paper gradient in each mode.",
    "feel": [
      "minimal",
      "bookish"
    ],
