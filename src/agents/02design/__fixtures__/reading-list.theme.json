    "fonts": {
      "ui": [
        {
          "family": "Inter",
          "reason": "Plain and legible at small sizes, for a calm list read often."
        },
        {
          "family": "Open Sans",
          "reason": "Friendly and open, a close second for long titles."
        },
        {
          "family": "Roboto",
          "reason": "Neutral and compact, but colder than the brief wants."
        }
      ],
      "display": [
        {
          "family": "Playfair Display",
          "reason": "A bookish serif for page titles, warm against the plain text."
        },
        {
          "family": "Montserrat",
          "reason": "Clean and confident, but less literary."
        },
        {
          "family": "Oswald",
          "reason": "Condensed and strong, louder than a quiet reading app."
        }
      ],
      "mono": [
        {
          "family": "JetBrains Mono",
          "reason": "Clear digits for page counts and dates."
        },
        {
          "family": "IBM Plex Mono",
          "reason": "Softer shapes, a good second."
        },
        {
          "family": "Roboto Mono",
          "reason": "Plain, with less character."
        }
      ]
    },
    "radius": "soft",
    "focusRing": "halo",
